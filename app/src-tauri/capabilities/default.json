{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call PenguinFin's own commands and nothing else: no file system, shell or HTTP access from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-boot",
    "allow-start-fresh",
    "allow-pick-import-file",
    "allow-cancel-import",
    "allow-confirm-import",
    "allow-save-settings",
    "allow-set-fred-key",
    "allow-remove-fred-key",
    "allow-save-fred-options",
    "allow-sync-market-data",
    "allow-export-backup",
    "allow-export-for-v2",
    "allow-reset-data"
  ]
}
